# Copy this file to `.env` for local development. Never commit `.env`.

# Local development: on. Production (Render): off.
DJANGO_DEBUG=True

# Production needs a long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames the backend answers on.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Websites allowed to call the API (the Vercel frontend + local dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origins allowed to submit forms to the admin (needed behind HTTPS in production).
CSRF_TRUSTED_ORIGINS=

# Leave empty locally to use the SQLite file. On Render this is set automatically
# from the Postgres database (postgres://...).
DATABASE_URL=

# Website address. The admin uses it to show product photos stored as /images/... on the site.
# Locally: http://localhost:5173 (with the frontend running). Production: your Vercel URL.
STORE_URL=http://localhost:5173
